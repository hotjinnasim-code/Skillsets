{
  "native_imagegen_exposed": true,
  "native_view_image_exposed": true,
  "native_imagegen": {
    "tool_name": "image_gen__imagegen",
    "callable_name": "tools.image_gen__imagegen",
    "invoked_via": "functions.exec",
    "argument_fields": [
      "num_last_images_to_include",
      "prompt",
      "referenced_image_paths",
      "transparent_background"
    ],
    "required_argument_fields": ["prompt"]
  },
  "native_view_image": {
    "tool_name": "view_image",
    "callable_name": "tools.view_image",
    "invoked_via": "functions.exec",
    "argument_fields": ["detail", "path"],
    "required_argument_fields": ["path"]
  }
}
